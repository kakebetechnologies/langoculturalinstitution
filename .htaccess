# Repository root of the Lango monorepo: web/ (PHP website, admin and API) and app/ (Expo mobile app).
#
# The real website lives in web/, which is the folder to point a hosting domain at (see web/README.md).
# For local XAMPP work this file serves web/ at the repository's own address, so
#   http://localhost/langoculturalinstitution/   still opens the site (and /admin/, /api/v1 ...) without the extra "/web".
# Nothing outside web/ is ever served: the mobile app's source, .env files and package.json stay private, because
# every request is mapped into web/, where web/.htaccess blocks app/, config/, database/ and legacy/.

Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
# On a live domain always use https. Not for this computer or a phone testing on the home network, and not behind a proxy that already did it.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.) [NC]
RewriteCond %{HTTP_HOST} !\.(local|test)(:[0-9]+)?$ [NC]
RewriteCond %{THE_REQUEST} \s(\S+)\s
RewriteRule ^ https://%{HTTP_HOST}%1 [R=301,L]
# Apache would add the missing trailing slash to a folder URL using the rewritten path (/admin -> /web/admin/), so do it here first.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^(admin|pwa)$ %{REQUEST_URI}/ [R=301,L]
# Map the request into web/ on the first pass only (an internal re-run of the rewritten URL has REDIRECT_STATUS set).
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^(.*)$ web/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
# Without mod_rewrite nothing can be mapped safely: show nothing rather than the source code.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
</IfModule>
