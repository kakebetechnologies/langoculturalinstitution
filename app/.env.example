# Lango app — copy to .env and edit. Only EXPO_PUBLIC_* variables reach the app code.
#
# The website API lives at <site>/api (the PHP site in ../web). While developing, leave this as "auto": the app then uses the
# address of the computer running the Expo dev server, with EXPO_PUBLIC_API_PATH below, so a phone on the same Wi-Fi keeps working
# when the computer's address changes. Or write the full address (use your computer's LAN IP, not localhost, for a phone):
#   Windows: ipconfig → IPv4 Address      macOS: ipconfig getifaddr en0      Linux: hostname -I
EXPO_PUBLIC_API_URL=auto
# Folder of the site on the dev computer (XAMPP: http://<ip>/langoculturalinstitution). Use "" when the site is at the server's root.
EXPO_PUBLIC_API_PATH=/langoculturalinstitution
# development | staging | production — picks the address from app.json → extra.apiUrl when EXPO_PUBLIC_API_URL is not set.
EXPO_PUBLIC_APP_ENV=development
