{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://langoculture.org/api", "EXPO_PUBLIC_APP_ENV": "production" }
    },
    "local-wifi": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "http://192.168.1.5/langoculturalinstitution/api", "EXPO_PUBLIC_APP_ENV": "development", "ALLOW_CLEARTEXT": "1" }
    },
    "production-apk": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://langoculture.org/api", "EXPO_PUBLIC_APP_ENV": "production" }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_API_URL": "https://langoculture.org/api", "EXPO_PUBLIC_APP_ENV": "production" }
    },
    "preview-ios": {
      "distribution": "internal",
      "autoIncrement": true,
      "ios": { "simulator": false },
      "env": { "EXPO_PUBLIC_API_URL": "https://langoculture.org/api", "EXPO_PUBLIC_APP_ENV": "production" }
    }
  },
  "submit": {
    "production": {}
  }
}
