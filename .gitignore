# Lango monorepo: web/ (PHP site, admin, API) and app/ (Expo mobile app).

# ===== Web (PHP) =====
web/config/config.php
web/config/first-run-credentials.txt
web/uploads/*
!web/uploads/.htaccess
# The installable web app (PWA) exported from app/ by `npm run app:pwa`
web/pwa/

# ===== App (Expo) =====
app/node_modules/
app/.expo/
app/.env
app/.env.local
app/dist/
app/dist-web/
app/web-build/
app/expo-env.d.ts
app/ios/
app/android/
app/*.jks
app/*.p8
app/*.p12
app/*.key
app/*.mobileprovision
.metro-health-check*

# ===== OS / IDE =====
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# ===== Logs / env =====
*.log
npm-debug.log*
.env
.env.*
!.env.example

# ===== Local tooling =====
.claude/

# Firebase service account keys (upload them to Expo, never commit them)
*firebase-adminsdk*.json
*service-account*.json
